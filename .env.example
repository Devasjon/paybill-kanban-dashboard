# Base URL of the companion Laravel backend (wasender-backend-laravel) — see
# src/lib/auth.ts, src/lib/cloudSync.ts, src/lib/receiptScan.ts, and
# src/lib/whatsapp.ts. Every logged-in user shares this one backend; there's
# no per-user URL to configure in the app anymore (see Settings).
VITE_API_BASE_URL=http://127.0.0.1:8000
